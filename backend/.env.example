NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bank_soal
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

JWT_ACCESS_SECRET=ganti-dengan-secret-access-yang-panjang
JWT_REFRESH_SECRET=ganti-dengan-secret-refresh-yang-panjang
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Isi dengan Web Client ID dari Google Cloud Console.
# Kosongkan saat Google login belum dikonfigurasi.
GOOGLE_CLIENT_ID=

# Di development token reset dikembalikan langsung oleh endpoint forgot-password.
# Di production token wajib dikirim melalui email service.
RESET_TOKEN_EXPIRES_MINUTES=30